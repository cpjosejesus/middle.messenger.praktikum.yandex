<main class="profile">
  <div class="profile__sidebar">
    <div data-id="backButton"></div>
  </div>
  <div class="profile__content">
    <div class="profile__avatar-wrap">
      <div data-id="avatar"></div>
    </div>
    <form class="profile__form" id="editProfileForm" autocomplete="on">
      <div class="profile__fields">
        <div data-id="emailInput"></div>
        <div data-id="loginInput"></div>
        <div data-id="firstNameInput"></div>
        <div data-id="secondNameInput"></div>
        <div data-id="displayNameInput"></div>
        <div data-id="phoneInput"></div>
      </div>
      <div data-id="saveButton"></div>
    </form>
  </div>
</main>
