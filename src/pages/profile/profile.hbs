<div class="profile">
  <div class="profile__sidebar">
    <button class="profile__back" id="backButton">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M10 3L5 8L10 13" stroke="#3369F3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
  <div class="profile__content">
    <div class="profile__avatar-wrap">
      <div data-id="avatar"></div>
    </div>
    <h2 class="profile__name">{{displayName}}</h2>

    <ul class="profile__info">
      <li class="profile__info-item">
        <span class="profile__info-label">Почта</span>
        <span class="profile__info-value">{{email}}</span>
      </li>
      <li class="profile__info-item">
        <span class="profile__info-label">Логин</span>
        <span class="profile__info-value">{{login}}</span>
      </li>
      <li class="profile__info-item">
        <span class="profile__info-label">Имя</span>
        <span class="profile__info-value">{{first_name}}</span>
      </li>
      <li class="profile__info-item">
        <span class="profile__info-label">Фамилия</span>
        <span class="profile__info-value">{{second_name}}</span>
      </li>
      <li class="profile__info-item">
        <span class="profile__info-label">Имя в чате</span>
        <span class="profile__info-value">{{display_name}}</span>
      </li>
      <li class="profile__info-item">
        <span class="profile__info-label">Телефон</span>
        <span class="profile__info-value">{{phone}}</span>
      </li>
    </ul>

    <ul class="profile__actions">
      <li class="profile__actions-item profile__actions-item--link" id="editProfile">
        Изменить данные
      </li>
      <li class="profile__actions-item profile__actions-item--link" id="changePassword">
        Изменить пароль
      </li>
      <li class="profile__actions-item profile__actions-item--danger" id="logout">
        Выйти
      </li>
    </ul>
  </div>
</div>
