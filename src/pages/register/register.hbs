<main class="auth">
  <div class="auth__card">
    <h1 class="auth__title">Регистрация</h1>
    <form class="auth__form" id="registerForm" autocomplete="on">
      <div class="auth__fields">
        <div data-id="emailInput"></div>
        <div data-id="loginInput"></div>
        <div data-id="firstNameInput"></div>
        <div data-id="secondNameInput"></div>
        <div data-id="phoneInput"></div>
        <div data-id="passwordInput"></div>
        <div data-id="passwordAgainInput"></div>
      </div>
      <div class="auth__actions">
        <div data-id="submitButton"></div>
        <a class="auth__link" href="/login">Войти</a>
      </div>
    </form>
  </div>
</main>
