<div class="messenger">
  <aside class="messenger__sidebar">
    <div class="messenger__sidebar-header">
      <a class="messenger__profile-link" href="/settings">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <circle cx="8" cy="5" r="3" stroke="#999" stroke-width="1.5"/>
          <path d="M2 14c0-3.314 2.686-6 6-6s6 2.686 6 6" stroke="#999" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        Профиль
        <svg class="messenger__profile-arrow" width="8" height="14" viewBox="0 0 8 14" fill="none">
          <path d="M1 1l6 6-6 6" stroke="#999" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </a>
      <div class="messenger__search">
        <input class="messenger__search-input" type="search" placeholder="Поиск" />
      </div>
    </div>
    <ul class="messenger__chat-list" id="chatList">
      {{#each chats}}
      <li class="chat-item {{#if this.active}}chat-item--active{{/if}}">
        <div class="avatar">
          <span class="avatar__placeholder">{{this.initials}}</span>
        </div>
        <div class="chat-item__body">
          <div class="chat-item__header">
            <span class="chat-item__name">{{this.name}}</span>
            <span class="chat-item__time">{{this.time}}</span>
          </div>
          <div class="chat-item__footer">
            <span class="chat-item__message">{{this.lastMessage}}</span>
            {{#if this.unreadCount}}
            <span class="chat-item__badge">{{this.unreadCount}}</span>
            {{/if}}
          </div>
        </div>
      </li>
      {{/each}}
    </ul>
  </aside>
  <main class="messenger__content">
    {{#if activeChat}}
    <div class="chat-window">
      <div class="chat-window__header">
        <div class="avatar">
          <span class="avatar__placeholder">{{activeChat.initials}}</span>
        </div>
        <div class="chat-window__header-info">
          <span class="chat-window__name">{{activeChat.name}}</span>
          <span class="chat-window__status">в сети</span>
        </div>
        <button class="chat-window__menu-btn" title="Настройки">
          <svg width="4" height="18" viewBox="0 0 4 18" fill="none">
            <circle cx="2" cy="2" r="2" fill="#999"/>
            <circle cx="2" cy="9" r="2" fill="#999"/>
            <circle cx="2" cy="16" r="2" fill="#999"/>
          </svg>
        </button>
      </div>
      <div class="chat-window__messages">
        {{#each activeChat.messages}}
        <div class="message {{#if this.isOutgoing}}message--out{{else}}message--in{{/if}}">
          <div class="message__bubble">
            <p class="message__text">{{this.text}}</p>
            <span class="message__time">{{this.time}}</span>
          </div>
        </div>
        {{/each}}
      </div>
      <div class="chat-window__footer">
        <button class="chat-window__attach-btn" title="Прикрепить файл">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M17 9.5L9.5 17C7.567 18.933 4.433 18.933 2.5 17 0.567 15.067 0.567 11.933 2.5 10L10 2.5C11.38 1.12 13.62 1.12 15 2.5 16.38 3.88 16.38 6.12 15 7.5L7.5 15C6.67 15.83 5.33 15.83 4.5 15 3.67 14.17 3.67 12.83 4.5 12L11.5 5" stroke="#999" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
        <input class="chat-window__input" type="text" placeholder="Сообщение" />
        <button class="chat-window__send-btn" title="Отправить">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M14 8H2M14 8L8 2M14 8L8 14" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>
    {{else}}
    <div class="messenger__empty">
      <p class="messenger__empty-text">Выберите чат, чтобы начать общение</p>
    </div>
    {{/if}}
  </main>
</div>
