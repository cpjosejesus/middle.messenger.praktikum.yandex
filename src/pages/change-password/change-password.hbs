<main class="profile">
  <div class="profile__sidebar">
    <div data-id="backButton"></div>
  </div>
  <div class="profile__content">
    <div class="profile__avatar-wrap">
      <div data-id="avatar"></div>
    </div>
    <form class="profile__form" id="changePasswordForm" autocomplete="new-password">
      <div class="profile__fields">
        <div data-id="oldPasswordInput"></div>
        <div data-id="newPasswordInput"></div>
        <div data-id="confirmPasswordInput"></div>
      </div>
      <div data-id="saveButton"></div>
    </form>
  </div>
</main>
